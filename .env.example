# Copy to .env.local and fill in. Never commit .env files.
# EmailJS (https://www.emailjs.com) — public key is designed to be client-side,
# but still keep it out of source control.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# The public address of the deployed site, no trailing slash. Makes WhatsApp/TikTok share previews work.
# Example: VITE_SITE_URL=https://your-name.github.io/emma-revelation   (leave empty until you know it)
VITE_SITE_URL=
